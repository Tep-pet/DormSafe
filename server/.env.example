PORT=5000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTESERVICE_API_KEY=
# Optional 100% free pedestrian walking directions key (https://openrouteservice.org)
CORS_ORIGIN=http://localhost:5173
# Set to 1 if npm run seed fails with "fetch failed" / SSL certificate errors (local dev only)
SUPABASE_INSECURE_SSL=
# Free Gmail SMTP Configuration (Nodemailer)
# Requires a 16-character Google App Password (myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=your_dormsafe_account@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM=DormSafe <your_dormsafe_account@gmail.com>

