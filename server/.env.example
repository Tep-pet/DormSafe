PORT=5000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_MAPS_API_KEY=
# Server-side key — enable Distance Matrix + Geocoding APIs; avoid browser referrer restrictions
CORS_ORIGIN=http://localhost:5173
# Set to 1 if npm run seed fails with "fetch failed" / SSL certificate errors (local dev only)
SUPABASE_INSECURE_SSL=
# Optional. Sends room-request notices to real inboxes (Gmail app password works).
# Addresses ending in @dormsafe.test are never emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
